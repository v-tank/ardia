{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ardia plugin",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "manifest": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1,
      "default": 1,
      "description": "The manifest's version"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,39}$",
      "description": "The plugin's name; its folder has the same name"
    },
    "title": {
      "type": "string",
      "pattern": "^[\\s\\S]{1,60}$"
    },
    "description": {
      "type": "string",
      "pattern": "^[\\s\\S]{1,200}$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d{1,6}\\.\\d{1,6}\\.\\d{1,6}(-[0-9A-Za-z.-]{1,40})?$"
    },
    "requires": {
      "type": "string",
      "pattern": "^\\d{1,6}\\.\\d{1,6}\\.\\d{1,6}(-[0-9A-Za-z.-]{1,40})?$",
      "description": "The first Ardia version the plugin works with"
    },
    "permissions": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "enum": [
          "tabs",
          "fullUrls",
          "commands",
          "network"
        ]
      }
    },
    "settings": {
      "type": "object",
      "description": "Version 1: defaults and rows. A file without manifest (version 0) gives Ardia settings here directly."
    },
    "commands": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
          },
          "title": {
            "type": "string",
            "pattern": "^[\\s\\S]{1,60}$"
          },
          "icon": {
            "type": "string",
            "pattern": "^[a-z0-9.]{1,64}$",
            "description": "An SF Symbol name"
          },
          "keywords": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "string",
              "pattern": "^[\\s\\S]{1,40}$"
            }
          },
          "tool": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
          },
          "input": {
            "type": "object"
          },
          "open": {
            "enum": [
              "tab",
              "split"
            ],
            "description": "Open the plugin's page as a tab, or in Split View beside the current tab"
          },
          "context": {
            "type": "boolean",
            "description": "Hand the page the current tab (needs the tabs permission)"
          },
          "side": {
            "enum": [
              "left",
              "right",
              "top",
              "bottom"
            ],
            "default": "right"
          },
          "sideSetting": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,40}$",
            "description": "A choice row whose value picks the side"
          }
        },
        "additionalProperties": false,
        "required": [
          "name",
          "title"
        ]
      }
    },
    "page": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "pattern": "^[\\s\\S]{1,40}$"
        },
        "icon": {
          "type": "string",
          "pattern": "^[a-z0-9.]{1,64}$",
          "description": "An SF Symbol name"
        },
        "file": {
          "type": "string",
          "pattern": "^[^/\\\\][^\\\\]*$"
        },
        "served": {
          "const": true
        }
      },
      "additionalProperties": false,
      "required": [
        "title"
      ]
    },
    "process": {
      "type": "object",
      "properties": {
        "run": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "string",
            "pattern": "^[^\\u0000]{1,1024}$"
          }
        },
        "memoryMB": {
          "type": "integer",
          "minimum": 64,
          "maximum": 4096,
          "default": 1024
        }
      },
      "additionalProperties": false,
      "required": [
        "run"
      ]
    },
    "hooks": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "enum": [
          "window.opened",
          "window.closed",
          "window.focused",
          "tab.opened",
          "tab.closed",
          "tab.activated",
          "tab.navigated",
          "settings.changed",
          "app.launched",
          "app.quitting",
          "app.activated",
          "app.deactivated",
          "tab.idle",
          "tab.resumed",
          "media.started",
          "media.stopped",
          "tab.crashed",
          "peek.opened",
          "peek.closed",
          "littleArdia.opened",
          "split.created",
          "split.closed",
          "pin.added",
          "pin.removed",
          "tab.moved",
          "profile.switched",
          "system.sleep",
          "system.wake",
          "user.idle",
          "user.active",
          "page.error"
        ]
      }
    },
    "tools": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
          },
          "title": {
            "type": "string",
            "pattern": "^[\\s\\S]{1,60}$"
          },
          "description": {
            "type": "string",
            "pattern": "^[\\s\\S]{1,200}$"
          },
          "timeout": {
            "type": "integer",
            "minimum": 1,
            "maximum": 300,
            "default": 30
          }
        },
        "additionalProperties": false,
        "required": [
          "name",
          "title"
        ]
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "name"
  ],
  "$defs": {
    "row": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,40}$"
        },
        "title": {
          "type": "string",
          "pattern": "^[\\s\\S]{1,60}$"
        },
        "description": {
          "type": "string",
          "pattern": "^[\\s\\S]{1,200}$"
        },
        "type": {
          "enum": [
            "toggle",
            "text",
            "choice"
          ]
        },
        "default": {
          "type": [
            "boolean",
            "string"
          ]
        },
        "choices": {
          "type": "array",
          "minItems": 2,
          "maxItems": 12,
          "items": {
            "type": "object",
            "properties": {
              "value": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,40}$"
              },
              "title": {
                "type": "string",
                "pattern": "^[\\s\\S]{1,60}$"
              }
            },
            "additionalProperties": false,
            "required": [
              "value",
              "title"
            ]
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "key",
        "title",
        "type",
        "default"
      ]
    }
  }
}
